# deploy.sh writes this the first time, with a new key, as SITE_DIR.env beside
# the site's folder, readable only by the site's user (chmod 600). Never commit
# the real file.
# A new key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=www.opensloper.com,opensloper.com
DJANGO_STATIC_ROOT=@SITE_DIR@/static_root
