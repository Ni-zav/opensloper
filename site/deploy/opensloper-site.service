# The opensloper.com site under gunicorn, which Apache passes requests to
# (apache-directives.conf). deploy.sh fills in the @...@ values for the server
# (the site's folder, and the SSH account's user and group) in its copy on
# the server; copy that one to /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now opensloper-site
# deploy.sh reloads it after each copy (a HUP, which needs no root).
[Unit]
Description=opensloper.com (Django under gunicorn)
After=network.target

[Service]
Type=simple
User=@SITE_USER@
Group=@SITE_GROUP@
WorkingDirectory=@SITE_DIR@
EnvironmentFile=@SITE_DIR@.env
ExecStart=@SITE_DIR@/venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 2 --access-logfile - opensloper_site.wsgi
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
