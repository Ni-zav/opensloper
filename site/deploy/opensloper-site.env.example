# Copy to /etc/opensloper-site.env, readable only by root (chmod 600), and fill
# in the key. Never commit the real file.
# A new key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=www.opensloper.com,opensloper.com
DJANGO_STATIC_ROOT=/srv/opensloper-site/static_root
